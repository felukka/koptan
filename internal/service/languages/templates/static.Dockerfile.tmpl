FROM nginxinc/nginx-unprivileged:{{.Version}}-alpine
USER root
RUN printf 'server {\n  listen {{.Port}};\n  server_name _;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' \
        > /etc/nginx/conf.d/default.conf
