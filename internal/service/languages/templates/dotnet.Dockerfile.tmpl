FROM mcr.microsoft.com/dotnet/sdk:{{.Version}} AS build
WORKDIR /src
COPY . .
RUN dotnet publish "{{.Extra.project}}" -c Release -o /out -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:{{.Version}}
WORKDIR /app
COPY --from=build /out .
ENV PORT={{.Port}} ASPNETCORE_URLS=http://+:{{.Port}}
EXPOSE {{.Port}}
USER {{.Extra.user}}
CMD {{json .StartCmd}}
