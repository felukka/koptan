FROM rust:{{.Version}}-bookworm AS build
WORKDIR /src
COPY . .
RUN {{.BuildCmd}}

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/release/{{.Entrypoint}} /app/{{.Entrypoint}}
ENV PORT={{.Port}}
EXPOSE {{.Port}}
USER 10001:10001
CMD {{json .StartCmd}}
