# syntax=docker/dockerfile:1
# Generated by Koptan: Python {{.Version}} with {{.PackageManager}}{{if .Framework}}, {{.Framework}}{{end}}.
FROM python:{{.Version}}-slim AS build
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH UV_PROJECT_ENVIRONMENT=/opt/venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
WORKDIR /app
COPY . .
RUN {{.InstallCmd}}{{if .Extra.extraPackages}} \
    && pip install --no-cache-dir {{.Extra.extraPackages}}{{end}}

FROM python:{{.Version}}-slim
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PORT={{.Port}}
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY . .
EXPOSE {{.Port}}
USER 10001:10001
CMD {{json .StartCmd}}
