# syntax=docker/dockerfile:1
# Generated by Koptan: Node {{.Version}} with {{.PackageManager}}, starts with {{.Entrypoint}}.
FROM {{if .Extra.image}}{{.Extra.image}}{{else}}node:{{.Version}}-bookworm-slim{{end}} AS build
WORKDIR /app
{{- if .Extra.corepack}}
RUN npm install -g corepack && corepack enable
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
{{- end}}
COPY . .
RUN {{.InstallCmd}}
{{- if .BuildCmd}}
RUN {{.BuildCmd}}
{{- end}}
{{- if .Extra.prune}}
RUN {{.Extra.prune}}
{{- end}}

FROM {{if .Extra.image}}{{.Extra.image}}{{else}}node:{{.Version}}-bookworm-slim{{end}}
WORKDIR /app
ENV NODE_ENV=production PORT={{.Port}}
COPY --from=build --chown=1000:1000 /app /app
EXPOSE {{.Port}}
USER 1000:1000
CMD {{json .StartCmd}}
