# syntax=docker/dockerfile:1
# Generated by Koptan: Java {{.Version}} with {{.PackageManager}}.
FROM {{.Extra.builderImage}} AS build
WORKDIR /src
COPY . .
RUN {{.BuildCmd}} \
    && jar="$(find {{.Extra.outputDir}} -maxdepth 1 -name '*.jar' ! -name '*-plain.jar' \
        ! -name '*-sources.jar' ! -name '*-javadoc.jar' ! -name 'original-*' | head -n1)" \
    && test -n "$jar" && cp "$jar" /app.jar

FROM eclipse-temurin:{{.Version}}-jre
WORKDIR /app
COPY --from=build /app.jar /app/app.jar
ENV PORT={{.Port}} JAVA_OPTS=""
EXPOSE {{.Port}}
USER 10001:10001
CMD {{json .StartCmd}}
